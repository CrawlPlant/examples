# Required for live Actor calls. Never commit your real .env.
APIFY_TOKEN=
# Maximum requested charge PER Actor run (not for a whole multi-Actor recipe).
APIFY_MAX_CHARGE_USD=0.50
APIFY_TIMEOUT_SECONDS=180
# Optional: only needed with --ai. Choose a model available to your account.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional recipe settings; defaults below are working examples.
PLAYER=Jannik Sinner
OPPONENT=Alcaraz
MATCH_PLAYER=Alcaraz
MATCH_OPPONENT=Djokovic
MATCH_DATE=2024-07-14
MATCH_TOURNAMENT=Wimbledon
SCOUT_PLAYER=Muchova
SCOUT_OPPONENT=Shnaider
SCOUT_DATE=2026-10-15
SCOUT_TOURNAMENT=Wuhan
DOMAIN=apify.com
YOUR_DOMAIN=scrapy.org
COMPETITOR=zyte.com
QUERY=milk
POSTCODE=2000
# Nearby ALDI example: the default Sydney 2000 postcode has no ALDI store.
ALDI_POSTCODE=2010
ADVERTISER=nike.com
DATE_FROM=yesterday
DATE_TO=yesterday

