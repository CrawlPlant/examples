{
  "title": "Export yesterday’s completed tennis matches",
  "process": "export",
  "steps": [
    {
      "name": "data",
      "actor": "flashscore-tennis",
      "input": {
        "maxItems": 20,
        "mode": "matches",
        "dateFrom": "${DATE_FROM}",
        "dateTo": "${DATE_TO}",
        "status": "finished",
        "tours": [
          "atp",
          "wta"
        ]
      }
    }
  ],
  "note": ""
}
